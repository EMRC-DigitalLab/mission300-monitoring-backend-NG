# Copy this file to .env.<environment> (e.g. .env.development) and fill in real values.
# NODE_ENV selects which .env.<environment> file is loaded at startup.

NODE_ENV=development
PORT=3000

# --- Database (Postgres) ---
DATABASE_URL=postgresql://m300:m300@localhost:5432/m300?schema=public

# --- Message broker (RabbitMQ) ---
RABBITMQ_URL=amqp://m300:m300@localhost:5672
RABBITMQ_EXCHANGE=m300.events

# --- Auth ---
JWT_SECRET=change-me-in-every-real-environment
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- File storage ---
# Where uploaded submission files / generated reports are written.
# On the Hostinger VPS this is a mounted volume path, not cloud blob storage.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Notifications ---
# Optional in local dev - without RESEND_API_KEY, emails are logged instead
# of sent (see src/notifications/email/email.service.ts). Webhook signing
# needs no env var - each subscription gets its own HMAC secret at creation.
RESEND_API_KEY=
EMAIL_FROM=M300 Compact Dashboard <notifications@m300.energymrc.ng>

# --- Health check ---
HEALTH_CHECK_PATH=/health
