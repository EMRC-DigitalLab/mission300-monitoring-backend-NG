* text=auto

# Keep scripts and container configuration executable/portable on Linux.
*.sh text eol=lf
Dockerfile text eol=lf
docker/Dockerfile text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.prisma text eol=lf
*.env text eol=lf
.env* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary fixtures and assets must never be line-ending normalized.
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
