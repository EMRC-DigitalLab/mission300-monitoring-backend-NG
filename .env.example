# Copy to .env.<environment> (e.g. .env.development). NODE_ENV selects which
# file is loaded at startup.

NODE_ENV=development
PORT=3000

POSTGRES_USER=m300
POSTGRES_PASSWORD=m300
POSTGRES_DB=m300
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://m300:m300@localhost:5432/m300?schema=public

RABBITMQ_USER=m300
RABBITMQ_PASSWORD=m300
RABBITMQ_URL=amqp://m300:m300@localhost:5672
RABBITMQ_EXCHANGE=m300.events
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

JWT_SECRET=change-me-in-every-real-environment
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:5173

RESEND_API_KEY=
EMAIL_FROM=M300 Compact Dashboard <notifications@raven-emrc.com>

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3009

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

SECRET_AMQP_USERNAME=bTMwMA==
SECRET_AMQP_PASSWORD=bTMwMA==
KESTRA_HOST_PORT=8081
KESTRA_ADMIN_USERNAME=admin@kestra.io
KESTRA_ADMIN_PASSWORD=change-me-in-every-real-environment
KESTRA_DB_USER=kestra
KESTRA_DB_PASSWORD=kestra-local-only
KESTRA_DB_NAME=kestra

API_HOST_PORT=3009

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

HEALTH_CHECK_PATH=/health
