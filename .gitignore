# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.npm/
.yarn/

# Build output and framework caches
dist/
build/
.nest/
.cache/

# Local environment files (templates remain versioned)
.env
.env.*
!.env.example
!.env.*.example
!.env.github.example

# generated secrets/keys - never commit these
.secrets-local/

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock

# Test and quality-tool output
coverage/
.nyc_output/
test-results/
junit.xml
.eslintcache

# IDE and editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Temporary Microsoft Office files
~$*

# Local Prisma databases
prisma/*.db
prisma/*.db-journal

# Temporary files
tmp/
temp/
*.tsbuildinfo

# machine-specific local dev overrides
docker/docker-compose.override.yml
docker/docker-compose.override.yaml

# local file storage (STORAGE_DRIVER=local) - uploaded files, never source
storage/
