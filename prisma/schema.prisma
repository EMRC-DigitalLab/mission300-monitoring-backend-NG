// M300 backend data model.
// Core principle (see modules/submissions + modules/kpis): a Submission is
// raw, versioned, user-entered data. A KpiValue is the "live" figure shown
// across the dashboard. Approving a submission is the ONLY thing allowed to
// write a new KpiValue - they are separate tables on purpose.

generator client {
  provider = "prisma-client-js"
}

// Connection URL is no longer set here (Prisma 7) - it lives in
// prisma.config.ts for the CLI, and is passed to the driver adapter
// (@prisma/adapter-pg) for the runtime client - see src/prisma/prisma.service.ts.
datasource db {
  provider = "postgresql"
}

// --- Identity & access -------------------------------------------------

enum RoleName {
  SYSTEM_ADMINISTRATOR
  INSTITUTIONAL_DATA_PROVIDER
  DATA_REVIEWER
  VALIDATOR
  DASHBOARD_MANAGER
  OVERSIGHT_USER
  READ_ONLY_USER
}

// PENDING: invited but hasn't set a password yet (cannot log in).
// ACTIVE: normal, can log in. INACTIVE/SUSPENDED: admin-disabled, cannot
// log in - see auth.service.ts's login() for exactly which states block it.
enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Permission {
  VIEW
  SUBMIT
  EDIT
  VALIDATE
  APPROVE
  EXPORT
  ADMINISTER
}

// Display/reference metadata for the 7 fixed roles - NOT a dynamic role
// system. The frontend has no create/edit/delete-role endpoint anywhere;
// this table exists purely so GET /administration can return label,
// description, permissions and reachable modules per role without hardcoding
// display strings in application code. Seeded once (see prisma/seed.ts),
// never written to by any API route.
model RoleDefinition {
  role        RoleName     @id
  label       String
  description String
  permissions Permission[]
  modules     String[]

  @@map("role_definitions")
}

model Institution {
  id            String   @id @default(cuid())
  name          String
  type          String // e.g. "Disco", "State Ministry", "Federal Agency"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  submissions   Submission[]
  dataCustodians DataCustodian[]
  ownedDatasets Dataset[]       @relation("DatasetOwner")
  obligations   Obligation[]

  @@map("institutions")
}

model User {
  id             String      @id @default(cuid())
  email          String      @unique
  passwordHash   String
  fullName       String
  /// Job title, e.g. "Monitoring Officer" - free text, matches the frontend's
  /// invite form and userAccountSchema.designation exactly (no enum backing it).
  designation    String      @default("")
  role           RoleName
  status         AccountStatus @default(PENDING)
  institutionId  String?
  institution    Institution? @relation(fields: [institutionId], references: [id])
  /// Set on every successful login (see auth.service.ts) - null for an
  /// invited account that has never signed in, matching userAccountSchema's
  /// lastLogin exactly.
  lastLogin      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  submissions      Submission[]      @relation("SubmittedBy")
  reviewDecisions  ReviewDecision[]  @relation("ReviewedBy")
  auditLogEntries  AuditLogEntry[]
  reports          Report[]
  uploadedFiles    UploadedFile[]
  webhookSubscriptions WebhookSubscription[]
  passwordResetTokens  PasswordResetToken[]
  scopeAssignments     ScopeAssignment[]
  focalForObligations  Obligation[]
  reviewingSubmissions Submission[]      @relation("SubmissionReviewer")

  @@index([institutionId])
  @@map("users")
}

// Read-only from the API's perspective - the real frontend (m300-frontend)
// has no create/edit/delete UI for this anywhere, only a display table
// (Administration > Access Scope). Matches scopeAssignmentSchema in
// src/api/schemas/administration.ts exactly.
enum ScopeLevel {
  NATIONAL
  STATE
  DISTRIBUTION_COMPANY
  INSTITUTION
  PROGRAMME
  PROJECT
  DATASET
  INDICATOR
}

model ScopeAssignment {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  level          ScopeLevel
  /// The specific state, DisCo, programme, etc., e.g. "Ikeja DisCo".
  scope          String
  responsibility String
  effectiveFrom  DateTime
  /// Null for an open-ended assignment.
  effectiveTo    DateTime?
  active         Boolean    @default(true)

  @@index([userId])
  @@map("scope_assignments")
}

// One mechanism, two callers: an invited user setting their first password,
// and an existing user resetting a forgotten one. Both just need to prove
// they own the email, then set a password - see AuthService.setPassword().
// tokenHash, never the raw token (same principle as passwordHash) - a stolen
// DB row can't be replayed as a working link.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Generic file storage record - any feature that lets a user upload an
// arbitrary file (not the structured submissions/upload flow, which parses
// its file into SubmissionItems instead of storing it as one of these)
// goes through StorageService + this table.
model UploadedFile {
  id           String   @id @default(cuid())
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@map("uploaded_files")
}

model DataCustodian {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  contactName   String
  contactEmail  String
  scope         String // free-text description of what this custodian owns

  @@index([institutionId])
  @@map("data_custodians")
}

// --- KPI catalogue & live values ---------------------------------------

model Pillar {
  id          String   @id @default(cuid())
  name        String   @unique
  /// Matches pillarIdSchema in m300-frontend/src/api/schemas/common.ts
  /// exactly (one of 6 fixed kebab-case codes, e.g. "generation-network") -
  /// kept as its own column rather than repurposing `id` so existing FKs
  /// (KpiDefinition.pillarId etc.) don't need to change.
  slug        String   @unique
  description String?

  kpis        KpiDefinition[]
  datasets    Dataset[]
  programmes  Programme[]
  projects    Project[]

  @@map("pillars")
}

// Matches readinessTierSchema in m300-frontend/src/api/schemas/kpi-
// explorer.ts exactly.
enum KpiReadinessTier {
  CORE
  SUPPORTING
  FUTURE
}

// Real contract requires a `direction` on every KPI profile
// (improvementDirectionSchema) but no mutation endpoint (create or edit)
// ever sets it - there's no way to configure this via the API at all, so
// it's a stored default rather than something PATCH/POST accept.
enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

// Matches the profile's targetBasis enum ('level'|'growth-rate'|'none') -
// see kpiProfileSchema.targetBasis in kpi-explorer.ts.
enum KpiTargetBasis {
  LEVEL
  GROWTH_RATE
  NONE
}

model KpiDefinition {
  id          String   @id @default(cuid())
  code        String   @unique // the real contract's human-facing `id` (e.g. "M300-GEN-004") - Prisma's own cuid `id` above is purely internal/FK plumbing
  name        String
  unit        String
  pillarId    String
  pillar      Pillar   @relation(fields: [pillarId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- KPI Explorer profile metadata (all editable via PATCH .../kpis/:id,
  // except direction - see KpiDirection above) ---
  category           String            @default("")
  readiness          KpiReadinessTier  @default(CORE)
  definition         String            @default("")
  formula            String            @default("")
  aggregation        String            @default("")
  frequency          String            @default("")
  disaggregation     String            @default("")
  limitations        String            @default("")
  sourceInstitution  String            @default("")
  sourceDataset      String            @default("")
  sourceReference    String            @default("")
  version            String            @default("1")
  direction          KpiDirection      @default(HIGHER_IS_BETTER)

  // --- Baseline/target (the single primary values every existing consumer
  // renders) - `targetPoints` below is the separate, additive periodic
  // checkpoint history (kpiTargetPointSchema). validationStatus/confidence/
  // current/history are NEVER stored - always derived at read time from
  // KpiValue + the Submission status that produced it, matching the real
  // contract's own rule that those only change via an approved submission.
  baseline           Decimal?
  baselineLabel      String            @default("")
  target             Decimal?
  targetLabel        String            @default("")
  targetDate         String?
  targetBasis        KpiTargetBasis?
  targetBasisLabel   String?
  /// Shape: { standard, inclusions[], exclusions[], periodType, assumptions[] } - see externalStandardAlignmentSchema. Null for the common case of no external standard mapped.
  externalStandardAlignment Json?

  values      KpiValue[]
  submissionItems SubmissionItem[]
  datasetFields   DatasetField[]
  targetPoints    KpiTargetPoint[]

  @@index([pillarId])
  @@map("kpi_definitions")
}

// One periodic target checkpoint (kpiTargetPointSchema) - additive to
// KpiDefinition's own single primary target/targetLabel/targetDate above,
// e.g. 2026 and 2028 milestones on the way to a 2030 goal. Replace-all
// semantics on PATCH .../kpis/:id (see updateKpiMetadataRequestSchema's
// own comment) - delete every row for a KPI and recreate from the
// request's `targets[]`, rather than trying to diff/match periods.
model KpiTargetPoint {
  id              String        @id @default(cuid())
  kpiDefinitionId String
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  period          String
  value           Decimal
  label           String

  @@index([kpiDefinitionId])
  @@map("kpi_target_points")
}

// The "live" value shown on dashboards. Written ONLY when the submission
// item carrying this KPI is approved or provisionally approved - one
// KpiValue per approved SubmissionItem, not per Submission (a single
// submission can carry many KPI items).
model KpiValue {
  id                  String         @id @default(cuid())
  kpiDefinitionId     String
  kpiDefinition       KpiDefinition  @relation(fields: [kpiDefinitionId], references: [id])
  institutionId       String?
  period              String // e.g. "2026-Q2"
  value               Decimal
  sourceSubmissionItemId String      @unique
  sourceSubmissionItem   SubmissionItem @relation(fields: [sourceSubmissionItemId], references: [id])
  approvedAt          DateTime

  @@index([kpiDefinitionId, period])
  @@map("kpi_values")
}

// --- Data Submissions & Validation ---------------------------------------
// Ground truth: m300-frontend's src/api/schemas/data-submissions/*.ts and
// src/mocks/data/data-submissions/*.ts. A submission is never freeform -
// it always exists against an Obligation (institution x dataset x
// reporting period, known in advance, with a due date). Fulfilling an
// obligation (an accepted submission) removes it from the outstanding
// obligations list - see obligation-status computation in
// data-submissions.mappers.ts, not a stored column here.

// What an institution can be asked to report - the record behind
// Obligation.dataset and the manual-entry form's field definitions.
model Dataset {
  id                 String   @id @default(cuid())
  name               String
  purpose            String
  pillarId           String
  pillar             Pillar   @relation(fields: [pillarId], references: [id])
  requiredDataPoints String[]
  frequency          String // e.g. "Quarterly" - free text, matches the real contract exactly
  ownerInstitutionId String?
  ownerInstitution   Institution? @relation("DatasetOwner", fields: [ownerInstitutionId], references: [id])
  // Used to build the template download URL (GET /data-submissions/templates/:fileName)
  // and the upload form's accepted-file-types display - the real contract
  // generates the XLSX fresh per request from these field definitions,
  // it is not a stored file.
  templateFileName   String
  templateVersion    Int      @default(1)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  fields             DatasetField[]
  obligations        Obligation[]

  @@index([pillarId])
  @@map("datasets")
}

enum DatasetFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  TEXTAREA
}

// One field of a dataset's manual-entry form - what makes that form
// "entirely server-driven" per the real contract (manualEntryDefinitionSchema).
model DatasetField {
  id              String           @id @default(cuid())
  datasetId       String
  dataset         Dataset          @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  sectionId       String // groups fields into entrySections for the manual-entry form
  sectionTitle    String
  label           String
  helpText        String?
  type            DatasetFieldType
  required        Boolean          @default(true)
  unit            String?
  order           Int              @default(0)
  // [{ value, label }] for SELECT fields - matches entryFieldSchema.options exactly
  options         Json?
  // Which KPI this field's value ultimately feeds (nullable - some fields
  // are descriptive only, e.g. sourceReference-adjacent notes).
  kpiDefinitionId String?
  kpiDefinition   KpiDefinition?   @relation(fields: [kpiDefinitionId], references: [id])

  @@index([datasetId])
  @@map("dataset_fields")
}

// The "what's owed, by when" record - institution x dataset x reporting
// period. Read-heavy: status/availableActions are computed at read time
// from the linked submission's state, not stored (same pattern as
// BrandingSettings/administration summary cards elsewhere in this schema).
model Obligation {
  id                   String       @id @default(cuid())
  institutionId        String
  institution          Institution  @relation(fields: [institutionId], references: [id])
  datasetId            String
  dataset              Dataset      @relation(fields: [datasetId], references: [id])
  reportingPeriod      String // e.g. "Q3 2025" - free text, matches the real contract
  dueDate              DateTime
  focalPersonId        String?
  focalPerson          User?        @relation(fields: [focalPersonId], references: [id])
  // Set only once a submission against this obligation is approved or
  // provisionally approved - see toObligationView() in
  // data-submissions.mappers.ts for the "removed from the outstanding
  // list once fulfilled" behavior this drives.
  acceptedSubmissionId String?      @unique
  acceptedSubmission   Submission?  @relation("AcceptedSubmission", fields: [acceptedSubmissionId], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  submissions          Submission[] @relation("ObligationSubmissions")

  @@unique([institutionId, datasetId, reportingPeriod])
  @@index([institutionId])
  @@index([datasetId])
  @@map("obligations")
}

// --- Submissions: draft -> pending -> under_review -> decision ----------

enum SubmissionStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  PROVISIONALLY_APPROVED
  RETURNED
  REJECTED
}

enum SubmissionMethod {
  MANUAL_ENTRY
  UPLOAD
}

model Submission {
  id             String            @id @default(cuid())
  institutionId  String
  institution    Institution       @relation(fields: [institutionId], references: [id])
  submittedById  String
  submittedBy    User              @relation("SubmittedBy", fields: [submittedById], references: [id])
  method         SubmissionMethod
  status         SubmissionStatus  @default(DRAFT)
  version        Int               @default(1)
  previousVersionId String?        @unique
  previousVersion   Submission?    @relation("SubmissionVersions", fields: [previousVersionId], references: [id])
  nextVersion       Submission?    @relation("SubmissionVersions")
  sourceFileUrl  String?
  // Nullable for now - populated once the real create/upload flow (Phase 2
  // of the Data Submissions rebuild) replaces the old direct-create path,
  // which has no obligation concept at all.
  obligationId   String?
  obligation     Obligation?       @relation("ObligationSubmissions", fields: [obligationId], references: [id])
  // Set by the real upload/entry flow - matches manualEntryRequestSchema/
  // the upload endpoint's multipart fields exactly.
  sourceReference String?
  notes          String?
  // The user's original file name (StorageService.save()'s `originalName`) -
  // separate from sourceFileUrl (the storage key) since SubmissionDetail.
  // fileName in the real contract must show what the submitter actually
  // called it, not a generated storage path.
  originalFileName String?
  // Assigned at upload time (see DataSubmissionsService.pickReviewer()) -
  // there's no explicit "assign a reviewer" action anywhere in the real
  // contract, but validationQueueItemSchema.reviewer is a required,
  // stable-per-submission field, so it has to be decided once and kept,
  // not recomputed differently on every read.
  reviewerId     String?
  reviewer       User?             @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  items          SubmissionItem[]
  reviewDecisions ReviewDecision[]
  acceptedForObligation Obligation? @relation("AcceptedSubmission")

  @@index([institutionId, status])
  @@index([obligationId])
  @@index([reviewerId])
  @@map("submissions")
}

model SubmissionItem {
  id              String        @id @default(cuid())
  submissionId    String
  submission      Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  kpiDefinitionId String
  kpiDefinition   KpiDefinition @relation(fields: [kpiDefinitionId], references: [id])
  period          String
  value           Decimal
  validationIssues Json?        // structured list of automated-check failures, if any
  kpiValue        KpiValue?

  @@index([submissionId])
  @@map("submission_items")
}

enum ReviewDecisionType {
  APPROVE
  PROVISIONALLY_APPROVE
  RETURN_FOR_CORRECTION
  REJECT
}

model ReviewDecision {
  id           String              @id @default(cuid())
  submissionId String
  submission   Submission          @relation(fields: [submissionId], references: [id])
  reviewedById String
  reviewedBy   User                @relation("ReviewedBy", fields: [reviewedById], references: [id])
  decision     ReviewDecisionType
  comment      String // mandatory - enforced in the service layer, not just here
  createdAt    DateTime            @default(now())

  @@index([submissionId])
  @@map("review_decisions")
}

// --- Programs / projects / milestones --------------------------------------
//
// Real contract: m300-frontend/src/api/schemas/programs.ts. The consolidated
// Programmes -> Projects -> (Milestones, Bottlenecks) drill-down - the old
// standalone "Implementation Register" spec and the old standalone
// "Bottlenecks & Exceptions" page were both folded into this one page on the
// frontend (see that file's own header comment). Bottlenecks itself is a
// separate Prisma model (Phase B of this rebuild, not yet added) - Project/
// Programme/Milestone.bottleneckCategory below are stored, not derived, and
// have no mutation endpoint that sets them (same pattern as KpiDefinition.
// direction) until Phase B wires a real linkage.

enum ExecutionStatus {
  ON_TRACK
  AT_RISK
  DELAYED
  BLOCKED
  COMPLETED
}

enum RegisterPriority {
  PRIORITY
  STANDARD
}

// Reused across Programme/Project/Milestone - matches validationStatusSchema
// in kpi-explorer.ts (imported into programs.ts for the same vocabulary).
// Unlike KPI Explorer's own validationStatus (always derived from a
// Submission), this one is a genuinely stored field here - there is no
// submission/approval pipeline behind Programs records.
enum ValidationStatus {
  CONFIRMED
  PUBLIC_SOURCE
  REQUIRES_VALIDATION
  PROVISIONAL
  FUTURE
}

enum ProgramType {
  GRANT
  CONCESSIONAL_LOAN
  PPP
  GOVERNMENT_FUNDED
  BLENDED_FINANCE
}

enum FundingStatus {
  COMMITTED
  DISBURSING
  FULLY_DISBURSED
  AT_RISK
  UNFUNDED
}

// Readiness of a project not yet in active delivery - distinct from
// lifecycleStage (identification->operations), which only applies once a
// project IS active. Null once active.
enum PipelineReadiness {
  PIPELINE
  FEASIBILITY_STUDY
  INVESTMENT_READY
}

enum LifecycleStage {
  IDENTIFICATION
  DESIGN
  PROCUREMENT
  IMPLEMENTATION
  COMMISSIONING
  OPERATIONS
}

// Matches bottleneckCategorySchema in bottlenecks.ts (imported into
// programs.ts) - defined here ahead of Phase B's Bottleneck model since
// Programme/Project/Milestone all carry a nullable bottleneckCategory.
enum BottleneckCategory {
  FINANCING
  PROCUREMENT
  PERMITTING
  REGULATORY_APPROVAL
  COORDINATION
  TECHNICAL_CONSTRAINT
  IMPLEMENTATION_DELAY
  DATA_OR_REPORTING
}

model Programme {
  id                     String            @id @default(cuid())
  name                   String
  leadInstitution        String
  supportingInstitutions String[]          @default([])
  pillarId               String
  pillar                 Pillar            @relation(fields: [pillarId], references: [id])
  objectives             String
  /// Null where financing is held at project level rather than programme level.
  financing              String?
  status                 ExecutionStatus   @default(ON_TRACK)
  priority               RegisterPriority  @default(STANDARD)
  startDate              DateTime
  endDate                DateTime
  bottleneckCategory     BottleneckCategory?
  validationStatus       ValidationStatus  @default(PROVISIONAL)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt // serves as the contract's `lastUpdate`

  projects               Project[]

  @@index([pillarId])
  @@map("programmes")
}

model Project {
  id                 String              @id @default(cuid())
  programmeId        String
  programme          Programme           @relation(fields: [programmeId], references: [id])
  name               String
  owner              String
  /// The named person leading delivery, distinct from `owner` (the accountable institution).
  leadName           String
  location           String
  /// Not in the real projectRecordSchema contract - the Executive Overview's
  /// ongoingProjects rows need coordinates for the delivery map, and the
  /// frontend does not geocode location strings, so this is captured here.
  latitude           Float
  longitude          Float
  coverage           String
  /// The workbook's "M300 Pillar Alignment" - a project can align to a
  /// different pillar than its parent programme's primary pillar.
  pillarId           String
  pillar              Pillar             @relation(fields: [pillarId], references: [id])
  lifecycleStage     LifecycleStage      @default(IDENTIFICATION)
  programType        ProgramType         @default(GOVERNMENT_FUNDED)
  /// Null where funding has not yet been secured.
  fundingSource      String?
  fundingStructure   String              @default("To be confirmed")
  fundingStatus      FundingStatus       @default(UNFUNDED)
  /// Null once a project is active (design stage or beyond).
  pipelineReadiness  PipelineReadiness?
  /// The status expected at this point in the plan, shown alongside `currentStatus`.
  projectedStatus    ExecutionStatus     @default(ON_TRACK)
  currentStatus      ExecutionStatus     @default(ON_TRACK)
  startDate          DateTime
  endDate            DateTime
  evidenceUrl        String?
  bottleneckCategory BottleneckCategory?
  /// The workbook's "Comment - Issues/Main Risk/Bottlenecks" narrative.
  comment            String              @default("")
  suggestion         String              @default("")
  validationStatus   ValidationStatus    @default(PROVISIONAL)

  // --- profile (projectProfileSchema) ---
  description        String              @default("")
  budgetUsd          Decimal             @default(0)
  disbursedUsd       Decimal             @default(0)
  contractor         String?
  contactName        String              @default("")
  contactEmail       String              @default("")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  statusHistory      ProjectStatusHistoryEntry[]
  milestones         Milestone[]
  documents          ProjectDocument[]
  updates            ProjectUpdate[]

  @@index([programmeId])
  @@index([pillarId])
  @@map("projects")
}

/// One reporting-cycle snapshot in a project's status trail - appended
/// whenever `currentStatus` actually changes value, not overwritten.
model ProjectStatusHistoryEntry {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  period    String
  status    ExecutionStatus
  createdAt DateTime        @default(now())

  @@index([projectId])
  @@map("project_status_history")
}

model ProjectDocument {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  url       String

  @@index([projectId])
  @@map("project_documents")
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime
  note      String

  @@index([projectId])
  @@map("project_updates")
}

model Milestone {
  id                 String              @id @default(cuid())
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id])
  name               String
  priority           RegisterPriority    @default(STANDARD)
  expectedDate       DateTime
  /// Null until the milestone is actually completed.
  actualDate         DateTime?
  status             ExecutionStatus     @default(ON_TRACK)
  leadInstitution    String
  evidenceUrl        String?
  risk               String              @default("")
  nextAction         String              @default("")
  bottleneckCategory BottleneckCategory?
  validationStatus   ValidationStatus    @default(PROVISIONAL)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([projectId])
  @@map("milestones")
}

// --- Reports --------------------------------------------------------------

enum ReportStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

enum ReportFormat {
  PDF
  XLSX
}

// Generation is async (RabbitMQ worker) - a row is created as QUEUED
// immediately so the UI can show it in history, then updated to READY with
// a fileUrl once the worker finishes. See events/consumers for the worker.
model Report {
  id            String       @id @default(cuid())
  requestedById String
  requestedBy   User         @relation(fields: [requestedById], references: [id])
  type          String // e.g. "pillar-summary", "compact-export"
  format        ReportFormat
  filters       Json
  status        ReportStatus @default(QUEUED)
  fileUrl       String?
  failureReason String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([requestedById])
  @@map("reports")
}

// --- Audit log ------------------------------------------------------------

// Human-readable action label + module + priorValue/newValue strings are
// derived at read time from `action`/`before`/`after` (see
// src/modules/administration/overview/audit-event.mapper.ts) rather than
// stored redundantly - `action` stays a machine key ("user.status_changed")
// so it's still usable for filtering/analytics independent of display text.
enum AuditResult {
  SUCCESS
  FAILURE
  REJECTED
}

model AuditLogEntry {
  id         String      @id @default(cuid())
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id])
  action     String // e.g. "submission.approved", "user.role_changed"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  result     AuditResult @default(SUCCESS)
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_log_entries")
}

// --- Branding ---------------------------------------------------------
// Single-row table (id is always "default"). Read by everyone via the
// public gateway/app shell; writable only by SYSTEM_ADMINISTRATOR. Shape
// matches the real frontend contract exactly (src/api/schemas/branding.ts
// in m300-frontend) - fonts/currency are stored as JSON since they're
// nested objects there (per-heading-level font family, ISO currency triple).
model BrandingSettings {
  id             String   @id @default("default")
  countryName    String   @default("Nigeria")
  primaryColor   String   @default("#004972")
  secondaryColor String   @default("#ffca05")
  textColor      String   @default("#101828")
  sidebarColor   String   @default("#004972")
  logoUrl        String   @default("/Logos/geapp.png")
  /// Shape: { h1, h2, h3, h4, h5, h6, body } - each a Google Fonts family name.
  fonts          Json
  /// Shape: { code, symbol, locale } - ISO 4217 code, display symbol, locale for digit grouping.
  currency       Json
  updatedAt      DateTime @updatedAt

  @@map("branding_settings")
}

// --- Notifications (email + webhooks) -----------------------------------
// Both channels are driven off the same domain events published to
// RabbitMQ (submission decisions, invites, report-ready, etc.) - see
// src/notifications. Email has no DB row of its own (Resend is the system
// of record for delivery status); webhooks need one, since a subscriber's
// endpoint can be down and we need something to retry/debug against.

model WebhookSubscription {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id])
  url         String
  secret      String // HMAC key for the X-M300-Signature header - shown once at creation
  events      String[] // routing-key patterns this subscription wants, e.g. "submission.*"
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  deliveries  WebhookDelivery[]

  @@index([ownerId])
  @@map("webhook_subscriptions")
}

enum WebhookDeliveryStatus {
  SUCCESS
  FAILED
}

// One row per delivery attempt, not per event - lets a caller see exactly
// what was sent and why a delivery failed, without needing external logs.
model WebhookDelivery {
  id             String                @id @default(cuid())
  subscriptionId String
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  status         WebhookDeliveryStatus
  responseStatus Int?
  error          String?
  createdAt      DateTime              @default(now())

  @@index([subscriptionId, createdAt])
  @@map("webhook_deliveries")
}
