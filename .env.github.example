# Checklist of GitHub Actions secrets required by .github/workflows/deploy.yml.
# These are NOT read from a file at runtime - this file only documents what
# must be configured under Settings -> Environments.
#
# staging and production run on the SAME Hostinger VPS (see docker/README
# notes in the main README's Deployment section) - that's exactly why these
# must be set as GitHub ENVIRONMENT secrets (Settings -> Environments ->
# "staging" / "production"), not repo-level secrets. The same secret NAME
# then holds a different VALUE per environment, which is what keeps the two
# deploys from ever pointing at each other's database or port.
#
# DEPLOY_SSH_* are the same for both environments (one VPS, one SSH user) -
# fine to set those as repo-level secrets instead of duplicating per
# environment, if preferred.

# --- Container registry (GitHub Container Registry) ---
# GITHUB_TOKEN is provided automatically by Actions - no secret needed for ghcr.io push.

# --- Hostinger VPS SSH deploy target (repo-level; one VPS for both envs) ---
DEPLOY_SSH_HOST=            # VPS IP or hostname
DEPLOY_SSH_USER=            # deploy user (not root)
DEPLOY_SSH_PORT=22
DEPLOY_SSH_PRIVATE_KEY=     # private key matching an authorized_keys entry on the VPS
# DEPLOY_HEALTH_CHECK_URL is NOT currently used: while there's no public domain
# yet, deploy.yml checks health internally (curl 127.0.0.1 over the same SSH
# session). Once a domain + host reverse proxy exist, add this secret back
# (per environment) and switch deploy.yml back to scripts/health-check.sh
# against it, e.g. https://api-staging.example.com/health.

# --- Per-environment secrets (set once under "staging", once under "production") ---

# Postgres/RabbitMQ container credentials for THIS environment's stack.
# Must be different between staging and production - they are separate
# databases even though they run on the same box.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Full connection strings the API container uses. Host is the Docker
# service name (postgres/rabbitmq), not localhost or the VPS's public IP -
# each environment's Compose project has its own isolated network, so
# "postgres"/"rabbitmq" always resolves to THIS environment's containers.
# Credentials must match POSTGRES_*/RABBITMQ_* above.
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public
RABBITMQ_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@rabbitmq:5672

JWT_SECRET=                 # different per environment - never reuse a staging secret in production
CORS_ORIGIN=                # the frontend origin(s) allowed to call this environment's API, comma-separated.
                            # Any *.vercel.app origin and any localhost/127.0.0.1 origin (any port) are
                            # ALWAYS allowed too, hardcoded in src/config/cors.ts - not configurable here.
