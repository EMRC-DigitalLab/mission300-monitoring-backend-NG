# Copy this file to .env.<environment> (e.g. .env.development) and fill in real values.
# NODE_ENV selects which .env.<environment> file is loaded at startup.

NODE_ENV=development
PORT=3000

# --- Database (Postgres) ---
DATABASE_URL=postgresql://m300:m300@localhost:5432/m300?schema=public

# --- Message broker (RabbitMQ) ---
RABBITMQ_URL=amqp://m300:m300@localhost:5672
RABBITMQ_EXCHANGE=m300.events

# --- Auth ---
JWT_SECRET=change-me-in-every-real-environment
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Used only to build set-password/reset-password links in emails, and to
# resolve the default logo (a frontend static asset) in email templates.
FRONTEND_URL=http://localhost:5173

# This API's own public base URL - separate from FRONTEND_URL because
# frontend and backend are different origins in staging/production. Used
# only to resolve an admin-uploaded email logo (GET /branding/logo/:filename
# is a backend route, not a frontend asset).
BACKEND_URL=http://localhost:3000

# First-boot only: creates one SYSTEM_ADMINISTRATOR if the users table is
# empty (invite-only system needs a first admin from somewhere). Optional -
# without these, an empty DB just stays empty until seeded another way.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- File storage ---
# Where uploaded submission files / generated reports are written.
# On the Hostinger VPS this is a mounted volume path, not cloud blob storage.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Notifications ---
# Optional in local dev - without RESEND_API_KEY, emails are logged instead
# of sent (see src/notifications/email/email.service.ts). Webhook signing
# needs no env var - each subscription gets its own HMAC secret at creation.
RESEND_API_KEY=
EMAIL_FROM=M300 Compact Dashboard <notifications@m300.energymrc.ng>

# --- Health check ---
HEALTH_CHECK_PATH=/health
